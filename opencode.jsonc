{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mantine": {
      "type": "local",
      "command": ["npx", "-y", "@mantine/mcp-server"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--browser", "chrome"],
      "enabled": true
    }
  }
}